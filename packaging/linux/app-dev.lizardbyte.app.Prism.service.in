[Unit]
Description=@PROJECT_DESCRIPTION@
StartLimitIntervalSec=500
StartLimitBurst=5
After=graphical-session.target xdg-desktop-autostart.target xdg-desktop-portal.service

[Service]
# Avoid starting Prism before the desktop is fully initialized.
ExecStartPre=/bin/sleep 5
@PRISM_SERVICE_START_COMMAND@
@PRISM_SERVICE_STOP_COMMAND@
@PRISM_SERVICE_CLEANUP_COMMAND@
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
Alias=prism.service
