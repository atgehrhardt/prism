#!/usr/bin/env bash
## @file
## @brief Launch Prism and its bundled service helpers from an AppImage or AppDir.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export PRISM_SESSION_DIR="$HERE/usr/libexec/prism"
export PRISM_BIN_DIR="$HERE/usr/bin"
# Libraries use executable-relative RPATHs. Do not leak LD_LIBRARY_PATH into games.
export PATH="$HERE/usr/bin:$PRISM_SESSION_DIR:$PATH"
export XKB_CONFIG_ROOT="$HERE/usr/share/xkb"
export XKB_BINDIR="$HERE/usr/bin"
export WLR_XWAYLAND="$HERE/usr/bin/Xwayland"
cd "$HERE"

case "${1:-}" in
  --check)
    [ "$#" = 1 ] || exit 64
    for executable in prism prism-input-bridge prism-hdr-calibration prism-labwc \
      prism-kwin-mode Xwayland prism-Xwayland xkbcomp wayland-info wlr-randr pactl; do
      [ -x "$HERE/usr/bin/$executable" ] || { echo "Missing payload: $executable" >&2; exit 1; }
    done
    for helper in appimage-manage.py install-appimage.sh \
      prism-headless-session.sh prism-headless-steam-session.sh \
      prism-steam-restore.sh prism-session-cleanup.sh prism-audio-common.sh \
      prism-headless-common.sh prism-headless-exec.sh; do
      [ -x "$PRISM_SESSION_DIR/$helper" ] || { echo "Missing helper: $helper" >&2; exit 1; }
    done
    for service in prism prism-headless-session prism-input-bridge prism-headless-steam prism-steam-restore; do
      [ -f "$HERE/usr/share/prism/appimage-services/$service.service" ] || exit 1
    done
    [ -d "$HERE/usr/share/prism/web" ]
    [ -d "$HERE/usr/share/xkb" ]
    # --help exits before config parsing, unlike --version which creates config files.
    "$HERE/usr/bin/prism" --help >/dev/null
    "$HERE/usr/bin/prism-labwc" --version
    ;;
  --install)
    [ "$#" = 2 ] || { echo 'Usage: --install /absolute/path/prism.AppImage' >&2; exit 64; }
    exec python3 "$PRISM_SESSION_DIR/appimage-manage.py" install "$2"
    ;;
  --remove)
    [ "$#" = 1 ] || exit 64
    exec python3 "$PRISM_SESSION_DIR/appimage-manage.py" remove
    ;;
  --update)
    [ "$#" = 1 ] || exit 64
    exec bash "$PRISM_SESSION_DIR/install-appimage.sh"
    ;;
  --internal)
    [ "$#" = 2 ] || exit 64
    case "$2" in
      session-cleanup|headless-session|headless-steam-session|steam-restore)
        exec "$PRISM_SESSION_DIR/prism-$2.sh" ;;
      input-bridge) exec "$HERE/usr/bin/prism-input-bridge" ;;
      *) echo 'Unknown internal component' >&2; exit 64 ;;
    esac
    ;;
  *) exec "$HERE/usr/bin/prism" "$@" ;;
esac
