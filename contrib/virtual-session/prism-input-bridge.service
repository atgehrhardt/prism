[Unit]
Description=Prism virtual input bridge for private labwc
After=prism-headless-session.service
BindsTo=prism-headless-session.service
PartOf=prism-headless-session.service

[Service]
Type=simple
EnvironmentFile=%t/prism-headless-input.env
ExecStart=%h/.local/bin/prism-input-bridge
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
