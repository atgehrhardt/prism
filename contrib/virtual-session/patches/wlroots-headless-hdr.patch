diff --git a/backend/headless/output.c b/backend/headless/output.c
index a4cdb17..6f1c5b4 100644
--- a/backend/headless/output.c
+++ b/backend/headless/output.c
@@ -11,7 +11,8 @@ static const uint32_t SUPPORTED_OUTPUT_STATE =
 	WLR_OUTPUT_STATE_BACKEND_OPTIONAL |
 	WLR_OUTPUT_STATE_BUFFER |
 	WLR_OUTPUT_STATE_ENABLED |
-	WLR_OUTPUT_STATE_MODE;
+	WLR_OUTPUT_STATE_MODE |
+	WLR_OUTPUT_STATE_IMAGE_DESCRIPTION;

 static size_t last_output_num = 0;

@@ -136,6 +137,12 @@ struct wlr_output *wlr_headless_add_output(struct wlr_backend *wlr_backend,
 	wlr_output_init(wlr_output, &backend->backend, &output_impl, backend->event_loop, &state);
 	wlr_output_state_finish(&state);

+	/* Prism's private virtual monitor accepts HDR10 without a physical sink.
+	 * The compositor still has to support color transforms and a 10-bit
+	 * render format before it can enable HDR on this output. */
+	wlr_output->supported_primaries = WLR_COLOR_NAMED_PRIMARIES_BT2020;
+	wlr_output->supported_transfer_functions = WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ;
+
 	output_update_refresh(output, 0);

 	size_t output_num = ++last_output_num;
