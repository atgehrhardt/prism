+/**
+ * @brief Read Prism's session-local SDR reference white, with bounded polling.
+ * @return Validated reference white in nits, or the upstream 203-nit default.
+ */
+static float prism_reference_white(void) {
+	static float white = 203;
+	static double next_check = 0;
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	double seconds = now.tv_sec + now.tv_nsec / 1e9;
+	if (seconds < next_check) {
+		return white;
+	}
+	next_check = seconds + 0.1;
+	white = 203;
+	const char *path = getenv("PRISM_HDR_SETTINGS_FILE");
+	if (path == NULL || path[0] == '\0') {
+		return white;
+	}
+	FILE *file = fopen(path, "r");
+	if (file == NULL) {
+		return white;
+	}
+	int version, candidate, peak;
+	char extra;
+	if (fscanf(file, "%d %d %d %c", &version, &candidate, &peak, &extra) == 3 &&
+			version == 1 && candidate >= 80 && candidate <= 500 &&
+			peak >= candidate && peak <= 4000) {
+		white = candidate;
+	}
+	fclose(file);
+	return white;
+}
