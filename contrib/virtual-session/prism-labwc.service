[Unit]
Description=Prism headless labwc compositor (virtual Prism capture target)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/labwc
ExecStartPost=%h/.local/bin/prism-labwc-link-socket.sh $MAINPID
ExecStopPost=/usr/bin/rm -f %t/wayland-prism
Environment=WLR_BACKENDS=headless
Environment=WAYLAND_DISPLAY=wayland-prism
Environment=XDG_SESSION_TYPE=wayland
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
